{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Probe",
  "description": "A checkable procedure attached to a claim. Everything except `Command` is static.",
  "oneOf": [
    {
      "description": "File exists in the tree.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "file_exists"
        },
        "path": {
          "description": "Path.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "path"
      ]
    },
    {
      "description": "File is absent from the tree.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "file_absent"
        },
        "path": {
          "description": "Path.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "path"
      ]
    },
    {
      "description": "File has exactly this blob.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "file_hash"
        },
        "path": {
          "description": "Path.",
          "type": "string"
        },
        "blob": {
          "description": "Expected blob.",
          "$ref": "#/$defs/GitOid"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "path",
        "blob"
      ]
    },
    {
      "description": "File content matches a regex at least `min` times.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "file_contains"
        },
        "path": {
          "description": "Path.",
          "type": "string"
        },
        "pattern": {
          "description": "Rust regex syntax.",
          "type": "string"
        },
        "min": {
          "description": "Minimum matches.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "path",
        "pattern",
        "min"
      ]
    },
    {
      "description": "Number of files matching a glob compares to `n`.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "glob_count"
        },
        "glob": {
          "description": "Glob.",
          "type": "string"
        },
        "op": {
          "description": "Comparison.",
          "$ref": "#/$defs/CmpOp"
        },
        "n": {
          "description": "Count.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "glob",
        "op",
        "n"
      ]
    },
    {
      "description": "A commit exists.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "git_commit_exists"
        },
        "oid": {
          "description": "Commit.",
          "$ref": "#/$defs/GitOid"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "oid"
      ]
    },
    {
      "description": "A branch points at a commit.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "git_branch_at"
        },
        "branch": {
          "description": "Branch name.",
          "type": "string"
        },
        "oid": {
          "description": "Commit.",
          "$ref": "#/$defs/GitOid"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "branch",
        "oid"
      ]
    },
    {
      "description": "A path has no uncommitted changes.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "git_path_clean"
        },
        "path": {
          "description": "Path.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "path"
      ]
    },
    {
      "description": "A symbol is defined.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "symbol_defined"
        },
        "path": {
          "description": "Restrict to a file.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "Name.",
          "type": "string"
        },
        "kind": {
          "description": "Restrict to a kind.",
          "anyOf": [
            {
              "$ref": "#/$defs/SymbolKind"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "name"
      ]
    },
    {
      "description": "No symbol with this name exists.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "symbol_absent"
        },
        "name": {
          "description": "Name.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "name"
      ]
    },
    {
      "description": "A symbol body has exactly this hash.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "symbol_hash"
        },
        "path": {
          "description": "File.",
          "type": "string"
        },
        "name": {
          "description": "Name.",
          "type": "string"
        },
        "body_hash": {
          "description": "Expected body hash.",
          "$ref": "#/$defs/B3"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "path",
        "name",
        "body_hash"
      ]
    },
    {
      "description": "Cross-check against the latest witnessed verification command. Executes nothing.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "ledger_verification"
        },
        "kind": {
          "description": "Kind of verification.",
          "$ref": "#/$defs/VerificationKind"
        },
        "matcher": {
          "description": "Optional argv prefix filter.",
          "anyOf": [
            {
              "$ref": "#/$defs/CommandMatcher"
            },
            {
              "type": "null"
            }
          ]
        },
        "require": {
          "description": "What counts as passing.",
          "$ref": "#/$defs/LedgerRequire"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "kind",
        "require"
      ]
    },
    {
      "description": "Execute a program. Policy gated.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "command"
        },
        "argv": {
          "description": "argv.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cwd_rel": {
          "description": "Working directory relative to the repo root.",
          "type": "string"
        },
        "shell": {
          "description": "Run through a shell (requires `allow_shell` and explicit approval).",
          "type": "boolean"
        },
        "timeout_s": {
          "description": "Timeout in seconds.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "expect": {
          "description": "Expected outcome.",
          "$ref": "#/$defs/Expect"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "argv",
        "cwd_rel",
        "shell",
        "timeout_s",
        "expect"
      ]
    },
    {
      "description": "All sub-probes must pass.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "all"
        },
        "probes": {
          "description": "Sub-probes.",
          "type": "array",
          "items": {
            "$ref": "#"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "probes"
      ]
    }
  ],
  "$defs": {
    "GitOid": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "CmpOp": {
      "description": "Comparison operator.",
      "oneOf": [
        {
          "description": "Equal.",
          "type": "string",
          "const": "eq"
        },
        {
          "description": "Not equal.",
          "type": "string",
          "const": "ne"
        },
        {
          "description": "Less than.",
          "type": "string",
          "const": "lt"
        },
        {
          "description": "Less or equal.",
          "type": "string",
          "const": "le"
        },
        {
          "description": "Greater than.",
          "type": "string",
          "const": "gt"
        },
        {
          "description": "Greater or equal.",
          "type": "string",
          "const": "ge"
        }
      ]
    },
    "SymbolKind": {
      "description": "Kind of source symbol.",
      "oneOf": [
        {
          "description": "Free function.",
          "type": "string",
          "const": "fn"
        },
        {
          "description": "Method.",
          "type": "string",
          "const": "method"
        },
        {
          "description": "Class.",
          "type": "string",
          "const": "class"
        },
        {
          "description": "Struct.",
          "type": "string",
          "const": "struct"
        },
        {
          "description": "Enum.",
          "type": "string",
          "const": "enum"
        },
        {
          "description": "Trait.",
          "type": "string",
          "const": "trait"
        },
        {
          "description": "Interface.",
          "type": "string",
          "const": "interface"
        },
        {
          "description": "Type alias.",
          "type": "string",
          "const": "type"
        },
        {
          "description": "Constant.",
          "type": "string",
          "const": "const"
        },
        {
          "description": "Module or namespace.",
          "type": "string",
          "const": "module"
        }
      ]
    },
    "B3": {
      "type": "string",
      "pattern": "^b3:[0-9a-f]{64}$"
    },
    "VerificationKind": {
      "description": "Kind of verification command.",
      "oneOf": [
        {
          "description": "Test runner.",
          "type": "string",
          "const": "test"
        },
        {
          "description": "Build.",
          "type": "string",
          "const": "build"
        },
        {
          "description": "Linter.",
          "type": "string",
          "const": "lint"
        },
        {
          "description": "Type checker.",
          "type": "string",
          "const": "typecheck"
        },
        {
          "description": "Recognized but uncategorized.",
          "type": "string",
          "const": "other"
        }
      ]
    },
    "CommandMatcher": {
      "description": "Filters witnessed commands by argv prefix.",
      "type": "object",
      "properties": {
        "argv_prefix": {
          "description": "argv prefix.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "argv_prefix"
      ]
    },
    "LedgerRequire": {
      "description": "Requirement for a ledger verification probe.",
      "oneOf": [
        {
          "description": "Exit code 0.",
          "type": "string",
          "const": "exit_zero"
        },
        {
          "description": "Parsed tests: zero failed and more than zero passed.",
          "type": "string",
          "const": "tests_all_pass"
        }
      ]
    },
    "Expect": {
      "description": "Expected outcome of a command probe.",
      "type": "object",
      "properties": {
        "exit": {
          "description": "Expected exit code.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "stdout_regex": {
          "description": "stdout must match.",
          "type": [
            "string",
            "null"
          ]
        },
        "stderr_absent_regex": {
          "description": "stderr must not match.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
