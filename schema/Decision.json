{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Decision",
  "description": "A decision with its reasons and constraint strength.",
  "type": "object",
  "properties": {
    "id": {
      "description": "Decision id.",
      "$ref": "#/$defs/Id_dec"
    },
    "text": {
      "description": "What was decided.",
      "type": "string"
    },
    "why": {
      "description": "Why.",
      "type": "string"
    },
    "alternatives": {
      "description": "Rejected alternatives.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Alternative"
      }
    },
    "constraint": {
      "description": "Constraint strength.",
      "anyOf": [
        {
          "$ref": "#/$defs/ConstraintKind"
        },
        {
          "type": "null"
        }
      ]
    },
    "scope": {
      "description": "What it applies to.",
      "anyOf": [
        {
          "$ref": "#/$defs/Scope"
        },
        {
          "type": "null"
        }
      ]
    },
    "leg": {
      "description": "Leg that made it.",
      "$ref": "#/$defs/Id_leg"
    },
    "origin": {
      "description": "Who made it.",
      "$ref": "#/$defs/ClaimOrigin"
    },
    "supersedes": {
      "description": "Decision this one replaces.",
      "anyOf": [
        {
          "$ref": "#/$defs/Id_dec"
        },
        {
          "type": "null"
        }
      ]
    },
    "active": {
      "description": "Whether it is still in force.",
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "text",
    "why",
    "alternatives",
    "leg",
    "origin",
    "active"
  ],
  "$defs": {
    "Id_dec": {
      "type": "string",
      "pattern": "^dec_[0-9a-f]{32}$"
    },
    "Alternative": {
      "description": "A rejected alternative.",
      "type": "object",
      "properties": {
        "text": {
          "description": "The alternative.",
          "type": "string"
        },
        "why_rejected": {
          "description": "Why it was rejected.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "text"
      ]
    },
    "ConstraintKind": {
      "description": "Constraint strength. `must` and `must_not` are never dropped from briefs.",
      "oneOf": [
        {
          "description": "Required.",
          "type": "string",
          "const": "must"
        },
        {
          "description": "Forbidden.",
          "type": "string",
          "const": "must_not"
        },
        {
          "description": "Preferred.",
          "type": "string",
          "const": "prefer"
        }
      ]
    },
    "Scope": {
      "description": "What a claim depends on.",
      "oneOf": [
        {
          "description": "The whole tree.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "repo"
            },
            "tree": {
              "description": "Tree oid at anchor time.",
              "$ref": "#/$defs/GitOid"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "tree"
          ]
        },
        {
          "description": "Specific files and symbols.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "items"
            },
            "files": {
              "description": "Files with blob oids.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/ScopedFile"
              }
            },
            "symbols": {
              "description": "Symbols with body and signature hashes.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/ScopedSymbol"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "files",
            "symbols"
          ]
        }
      ]
    },
    "GitOid": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "ScopedFile": {
      "description": "A file in a claim scope.",
      "type": "object",
      "properties": {
        "path": {
          "description": "Repo-relative path.",
          "type": "string"
        },
        "blob": {
          "description": "Blob at anchor time; `None` means absent at anchor.",
          "anyOf": [
            {
              "$ref": "#/$defs/GitOid"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "path"
      ]
    },
    "ScopedSymbol": {
      "description": "A symbol in a claim scope.",
      "type": "object",
      "properties": {
        "path": {
          "description": "File containing the symbol at anchor time.",
          "type": "string"
        },
        "name": {
          "description": "Symbol name.",
          "type": "string"
        },
        "kind": {
          "description": "Symbol kind.",
          "$ref": "#/$defs/SymbolKind"
        },
        "body_hash": {
          "description": "Formatting-insensitive body hash.",
          "$ref": "#/$defs/B3"
        },
        "sig_hash": {
          "description": "Signature hash.",
          "$ref": "#/$defs/B3"
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "name",
        "kind",
        "body_hash",
        "sig_hash"
      ]
    },
    "SymbolKind": {
      "description": "Kind of source symbol.",
      "oneOf": [
        {
          "description": "Free function.",
          "type": "string",
          "const": "fn"
        },
        {
          "description": "Method.",
          "type": "string",
          "const": "method"
        },
        {
          "description": "Class.",
          "type": "string",
          "const": "class"
        },
        {
          "description": "Struct.",
          "type": "string",
          "const": "struct"
        },
        {
          "description": "Enum.",
          "type": "string",
          "const": "enum"
        },
        {
          "description": "Trait.",
          "type": "string",
          "const": "trait"
        },
        {
          "description": "Interface.",
          "type": "string",
          "const": "interface"
        },
        {
          "description": "Type alias.",
          "type": "string",
          "const": "type"
        },
        {
          "description": "Constant.",
          "type": "string",
          "const": "const"
        },
        {
          "description": "Module or namespace.",
          "type": "string",
          "const": "module"
        }
      ]
    },
    "B3": {
      "type": "string",
      "pattern": "^b3:[0-9a-f]{64}$"
    },
    "Id_leg": {
      "type": "string",
      "pattern": "^leg_[0-9a-f]{32}$"
    },
    "ClaimOrigin": {
      "description": "Who asserted a claim and how confident the source is.",
      "type": "object",
      "properties": {
        "source": {
          "description": "Source kind.",
          "$ref": "#/$defs/OriginSource"
        },
        "agent": {
          "description": "Agent, if any.",
          "anyOf": [
            {
              "$ref": "#/$defs/AgentId"
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence_permille": {
          "description": "Confidence in permille (0 to 1000). Integer, never a float.",
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535
        }
      },
      "additionalProperties": false,
      "required": [
        "source",
        "confidence_permille"
      ]
    },
    "OriginSource": {
      "description": "Origin of a claim.",
      "oneOf": [
        {
          "description": "Derived from witnessed events.",
          "type": "string",
          "const": "witnessed"
        },
        {
          "description": "Declared by the agent.",
          "type": "string",
          "const": "agent_declared"
        },
        {
          "description": "Declared by a human.",
          "type": "string",
          "const": "human"
        },
        {
          "description": "Extracted from transcript narration.",
          "type": "string",
          "const": "transcript_extracted"
        },
        {
          "description": "Imported from a markdown handoff.",
          "type": "string",
          "const": "imported"
        }
      ]
    },
    "AgentId": {
      "description": "Supported agents.",
      "oneOf": [
        {
          "description": "Claude Code.",
          "type": "string",
          "const": "claude-code"
        },
        {
          "description": "OpenAI Codex CLI.",
          "type": "string",
          "const": "codex"
        },
        {
          "description": "Gemini CLI.",
          "type": "string",
          "const": "gemini-cli"
        },
        {
          "description": "OpenCode.",
          "type": "string",
          "const": "opencode"
        },
        {
          "description": "Any other agent, through `firsthand run`, MCP, or the CLI.",
          "type": "string",
          "const": "generic"
        }
      ]
    }
  }
}
